# Modello per la firma della build release.
# Copia questo file in "keystore.properties" (non versionato) e compila i valori.
#
# Creazione della chiave (una volta sola; conserva il file .jks e le password):
#   keytool -genkeypair -v -keystore imposteur-release.jks -alias imposteur -keyalg RSA -keysize 4096 -validity 10000
#
# Build:
#   ./gradlew :app:assembleRelease   (APK in app/build/outputs/apk/release/)
#   ./gradlew :app:bundleRelease     (AAB per il Play Store)
#
# Senza keystore.properties la release resta non firmata.

# Percorso del keystore: relativo alla radice del progetto o assoluto
storeFile=imposteur-release.jks
storePassword=PASSWORD_DEL_KEYSTORE
keyAlias=imposteur
keyPassword=PASSWORD_DELLA_CHIAVE
